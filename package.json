{
  "name": "desktop-buddy-kimi",
  "version": "0.1.0",
  "description": "Pixel-art desktop pet overlay (Windows-first, cross-platform)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "test": "node --test \"tests/*.test.ts\"",
    "smoke": "electron . -- --smoke"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^37.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true
  }
}
